# Copy to .env.e2e.local and fill in. .env.e2e.local is gitignored and must never be committed.
E2E_BASE_URL=https://localhost:3000
E2E_API_BASE_URL=https://localhost:7163
E2E_ORGANIZER_USERNAME=
E2E_ORGANIZER_PASSWORD=
# A supporter account: one that does not administer the campaign under test, because whoever runs a
# campaign is refused a fundraising page on it.
E2E_SUPPORTER_USERNAME=
E2E_SUPPORTER_PASSWORD=
E2E_SQLCMD=C:\Program Files\Microsoft SQL Server\Client SDK\ODBC\180\Tools\Binn\sqlcmd.exe
# Points at the API's own gitignored secrets file so the database password lives in exactly one place.
E2E_API_SECRETS_FILE=D:\V4Ideas\Ideali\ideali.api\src\Presentation\Ideas.API\Configuration\secrets.MACHINE-NAME.json
